+        win_reason="goal",
+        p1_elo_before=1200,
+        p1_elo_after=1300,
+        p2_elo_before=1200,
+        p2_elo_after=1100,
+        is_bracket=False,
+        created_at=base_time,
+    )
+    # Bracket match (should be excluded)
+    m_bracket = Match(
+        player1_id=u1.id,
+        player2_id=u2.id,
+        winner_id=u1.id,
+        win_reason="goal",
+        p1_elo_before=1300,
+        p1_elo_after=1350,
+        p2_elo_before=1100,
+        p2_elo_after=1050,
+        is_bracket=True,
+        created_at=base_time + timedelta(minutes=10),
+    )
+    # Incomplete pending match (no winner, no win_reason)
+    m_pending = Match(
+        player1_id=u1.id,
+        player2_id=u2.id,
+        winner_id=None,
+        win_reason=None,
+        p1_elo_before=1300,
+        p1_elo_after=None,
+        p2_elo_before=1100,
+        p2_elo_after=None,
+        is_bracket=False,
+        created_at=base_time + timedelta(minutes=20),
