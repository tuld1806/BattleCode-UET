+    assert data["users"][0]["username"] == "champion"
+    assert data["users"][0]["rank"] == 1
+    assert "points" in data["users"][0]
+    assert "color" in data["users"][0]
+    assert data["users"][1]["username"] == "contender"
+    assert data["users"][1]["rank"] == 2
