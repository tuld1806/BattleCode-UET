+    db_session.commit()
+
+    res1 = get_user_rating_history(user_id=u1.id, db=db_session)
+    assert res1["total_matches"] == 1
+    assert len(res1["points"]) == 2
+    assert res1["points"][1]["match_id"] == m_reg.id
+
